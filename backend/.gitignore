# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Node dependencies
node_modules/
dist/

# Logs
*.log

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Test and coverage files
.pytest_cache/
.coverage
htmlcov/
